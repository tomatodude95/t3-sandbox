FROM docker/sandbox-templates:shell-docker

# Base image already provides: non-root `agent` user at UID 1000 with
# passwordless sudo, /home/agent, Node.js/npm, git, make, python3 — the
# requirements docs.docker.com/ai/sandboxes/customize/kit-reference lists for
# a custom `kind: sandbox` kit image. g++ is the one build-toolchain piece
# missing, needed because node-pty (a t3 dependency) has no prebuilt binary
# for arm64 and compiles from source.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends g++ \
    && rm -rf /var/lib/apt/lists/*

USER agent

# Providers T3 Code drives, plus T3 Code itself.
RUN npm install -g \
        t3@latest \
        @anthropic-ai/claude-code \
        @openai/codex \
        opencode-ai \
    && npm cache clean --force

WORKDIR /home/agent/workspace

COPY --chown=agent:agent entrypoint.sh /usr/local/bin/entrypoint.sh
USER root
RUN chmod +x /usr/local/bin/entrypoint.sh
USER agent

EXPOSE 3773

# Deliberately no VOLUME here (unlike the plain-Docker Dockerfile) — sbx
# already manages this whole sandbox's persistence/lifecycle itself
# (survives stop/restart, wiped on `sbx rm`), and a `VOLUME` declaration
# interacting with sbx's own erofs-based snapshotter is a likely contributor
# to /home/agent starting out incompletely initialized.
#
# Deliberately no ENTRYPOINT/CMD override here — keep the base image's own
# ["tini", "--"] / ["bash"]. sbx execs into the running container after
# startup to inject kit files and its own generated agent-launch script; if
# our own entrypoint becomes PID1 and t3 serve exits or the process model
# doesn't match what sbx expects, the container isn't there anymore by the
# time sbx tries to exec into it (confirmed: sbx-custom-kit/spec.yaml launches
# entrypoint.sh as a backgrounded `setup.startup` command instead).
