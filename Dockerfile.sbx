FROM docker/sandbox-templates:shell-docker

# The base image has the kit's agent user, Node, git and python3. g++ is for
# node-pty (a t3 dependency), which compiles from source on linux/arm64.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends g++ \
    && rm -rf /var/lib/apt/lists/*

USER agent

# T3 Code doesn't use the Copilot CLI yet.
RUN npm install -g \
        t3@latest \
        @anthropic-ai/claude-code \
        @openai/codex \
        opencode-ai \
        @github/copilot \
    && npm cache clean --force

WORKDIR /home/agent/workspace

COPY --chown=agent:agent entrypoint.sh /usr/local/bin/entrypoint.sh
USER root
RUN chmod +x /usr/local/bin/entrypoint.sh
USER agent

EXPOSE 3773

# No VOLUME: sbx persists the sandbox. No ENTRYPOINT: the base image's PID 1
# keeps the container up; sbx starts entrypoint.sh via t3-kit/spec.yaml.
